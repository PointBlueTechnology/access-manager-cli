# amcli settings. Copy to a file of your own (for example .env, which git ignores) and use it with
#   amcli --env-file .env <command>      or      export AMCLI_ENV_FILE=.env
# The same names work as ordinary environment variables.

# The Administration Console; /nps is added
AMCLI_URL=https://ac.example.com:8443

# A console administrator
AMCLI_USER=admin

# Its DN, for the older /amsvc/v1 API that export also reads
# (default: AMCLI_USER if it's a DN, otherwise cn=<AMCLI_USER>,o=novell)
# AMCLI_LEGACY_USER=cn=admin,o=novell

# Its password, or a file holding it (never pass it on the command line)
AMCLI_PASSWORD=
# AMCLI_PASSWORD_FILE=/path/to/password

# PEM file of the CA that signed the console's certificate
# AMCLI_CA_FILE=/path/to/console-ca.pem

# The name on the console's certificate, when AMCLI_URL uses an address
# AMCLI_TLS_SERVERNAME=ac.example.com

# Skip certificate checks: test systems only
# AMCLI_INSECURE=1

# The Identity Server cluster, by name or ID; not needed when there's only one
# AMCLI_CLUSTER=IDP-Cluster

# Per-request timeout in milliseconds (default 60000)
# AMCLI_TIMEOUT_MS=60000
